ports:
  tarot_proxy: 64910

app:
  title: Icare
  acknowledgment: >-
      This work made use of the ICARE version of SkyPortal (van der Walt et al.
      2019, Coughlin et al. 2023), jointly developed at Caltech, UC Berkeley, the
      University of Minnesota, and Université Paris-Saclay.
  factory: skyportal.app_server_icare.make_app_icare
  # Sign in through IAM rather than SkyPortal's default Google button.
  login_buttons:
    - url: /login/iam-oauth2
      image: /static/images/btn_iam_signin.png
      alt_text: Click this image to log in
    # Copy for the About page, rendered by SkyPortal's AboutPlugins template.
  about:
    description: >-
      ICARE is an open source codebase that serves as a dynamic collaborative
      platform for time-domain astronomy. It is being jointly developed at
      Caltech, UC Berkeley, the University of Minnesota, and Université
      Paris-Saclay.
    homepage_url: https://skyportal-icare.ijclab.in2p3.fr
    docs_url: https://grandma-skyportal.readthedocs.io
    api_docs_url: https://skyportal.io/docs/api.html
    repository_url: https://github.com/grandma-collaboration/icare
    changelog_repositories:
      - name: ICARE
        url: https://github.com/grandma-collaboration/icare/pulls
      - name: SkyPortal
        url: https://github.com/skyportal/skyportal/pulls
    # Accepted once per version; bump the version to ask everyone again.
  terms_of_service:
    enabled: true
    version: "2026-10-13"
    title: ICARE Terms of Service
    text_file: data/icare_terms_of_service.md
    # A token cannot be shown the dialog; its owner still accepts at next login.
    exempt_tokens: true
  observation_plan:
    default_filters: ['ztfg', 'ztfr', 'ztfi']
    use_skyportal_fields: False

  # Tarot API endpoints
  tarot_proxy_endpoint: http://localhost:64910/
  tarot_endpoint: http://cador.tarotnet.org/ros
  calern_endpoint: http://tca4.tarotnet.org/ros/klotz
  chili_endpoint: http://tch4.tarotnet.org/ros/klotz
  reunion_endpoint: http://tre4.tarotnet.org/ros/klotz

  routes:
    - path: "/"
      component: templates/HomePage
      exact: True
    - path: "/sources"
      component: source/SourceList
    - path: "/source/:id"
      component: source/Source
    - path: "/source/:id/finder"
      component: FindingChart
    - path: "/source/:id/periodogram"
      component: Periodogram
    - path: "/source/:obj_id/analysis/:analysis_id"
      component: source/SourceAnalysisPage
    - path: "/favorites"
      component: listing/FavoritesPage
    - path: "/discussions"
      component: discussion/Discussions
    - path: "/data_access_requests"
      component: DataAccessRequestsPage
    - path: "/source_interests"
      component: source/SourceInterestsPage
    - path: "/groups"
      component: group/Groups
    - path: "/group/:id"
      component: group/Group
    - path: "/teams"
      component: team/Teams
    - path: "/group_sources/:id"
      component: group/GroupSources
    - path: "/candidates"
      component: candidate/CandidateList
    - path: "/candidates/scan_reports"
      component: candidate/scan_reports/ReportsList
    - path: "/profile"
      component: user/Profile
    - path: "/brokers"
      component: broker/BrokerList
    - path: "/brokers/:brokerId"
      component: broker/Broker
    - path: "/user/:id"
      component: user/PublicProfile
    - path: "/upload_photometry/:id"
      component: photometry/UploadPhotometry
    - path: "/share_data/:id"
      component: source/ShareDataForm
    - path: "/filter/:fid"
      component: filter/Filter
    - path: "/about"
      component: About
    - path: "/deployments"
      component: deployment/Deployments
    - path: "/runs"
      component: observing_run/ObservingRunPage
    - path: "/run/:id"
      component: observing_run/RunSummary
    - path: "/allocations"
      component: allocation/AllocationList
    - path: "/allocation/:id"
      component: allocation/Allocation
    - path: "/instruments"
      component: instrument/InstrumentList
    - path: "/instrument/:id"
      component: instrument/Instrument
    - path: "/telescopes"
      component: telescope/TelescopeList
    - path: "/telescope/:id"
      component: telescope/Telescope
    - path: "/observations"
      component: observation/ObservationPage
    - path: "/galaxies"
      component: galaxy/GalaxyPage
    - path: "/spatial_catalogs"
      component: spatial_catalog/SpatialCatalogPage
    - path: "/followup_requests"
      component: followup_request/FollowupRequestPage
    - path: "/user_management"
      component: user/UserManagement
    - path: "/upload_spectrum/:id"
      component: spectrum/UploadSpectrum
    - path: "/observability/:id"
      component: source/Observability
    - path: "/db_stats"
      component: DBStats
    - path: "/source_statistics"
      component: SourceStatistics
    - path: "/gcn_events"
      component: gcn/GcnEvents
    - path: "/gcn_events/:dateobs"
      component: gcn/GcnEventPage
    - path: "/gcn_events/:dateobs/analysis/:analysis_id"
      component: source/GcnEventAnalysisPage
    - path: "/mmadetectors"
      component: mma_detector/MMADetectorPage
    - path: "/earthquakes"
      component: earthquake/EarthquakesPage
    - path: "/earthquakes/:event_id"
      component: earthquake/EarthquakePage
    - path: "/services"
      component: analysis/AnalysisServicePage
    - path: "/analysis_requests"
      component: analysis/AnalysisRequestPage
    - path: "/observation_plan_requests"
      component: observation_plan/ObservationPlanRequestPage
    - path: "/recurring_apis"
      component: RecurringAPIPage
    - path: "/shifts"
      component: shift/ShiftNoId
    - path: "/shifts/:id"
      component: shift/ShiftWithId
    - path: "/summary_search"
      component: summary/SummarySearch
    - path: "/tag_management"
      component: TagManagement
    - path: "/taxonomies"
      component: taxonomy/TaxonomyList
    - path: "/sharing_services"
      component: sharing_service/SharingServicesPage
    - path: "/sharing_service/:id/submissions"
      component: sharing_service/SharingServiceSubmissionsPage
    - path: "/moving_objects/obsplan"
      component: moving_object/MovingObjectObsPlanPage

  sidebar:
    # See https://material-ui.com/components/material-icons/
    - name: main
      subitems:
        - name: Dashboard
          icon: Home
          url: /

        - name: GW/GRB/Neutrino
          icon: SettingsInputAntenna
          url: /gcn_events

        - name: Sources
          icon: Storage
          url: /sources

        - name: Candidates
          icon: Search
          url: /candidates

        - name: Brokers
          icon: Hub
          url: /brokers

        - name: Favorites
          icon: Star
          url: /favorites

        - name: Discussions
          icon: Forum
          url: /discussions

        - name: Groups
          icon: GroupWork
          url: /groups

        - name: Teams
          icon: Diversity3
          url: /teams

        - name: Observing Runs
          icon: NightsStay
          url: /runs

        - name: Followup Requests
          icon: WorkOutlined
          url: /followup_requests

        - name: Analysis Requests
          icon: Analytics
          url: /analysis_requests

        - name: Observation Plans
          icon: Assignment
          url: /observation_plan_requests

        - name: Data Requests
          icon: LockOpen
          url: /data_access_requests

        - name: Interests
          icon: Handshake
          url: /source_interests

        - name: Shifts
          icon: CalendarMonth
          url: /shifts

        - name: Source Statistics
          icon: ScatterPlot
          url: /source_statistics

        - name: About
          icon: Info
          url: /about

    - name: Other
      icon: MoreHoriz
      subitems:
        - name: Telescopes
          icon: MyLocation
          url: /telescopes

        - name: Instruments
          icon: CameraAlt
          url: /instruments

        - name: MMADetectors
          icon: Sensors
          url: /mmadetectors

        - name: Allocations
          icon: HourglassEmptyOutlined
          url: /allocations

        - name: Observations
          icon: ZoomInOutlined
          url: /observations

        - name: Sharing Services
          icon: Share
          url: /sharing_services

        - name: Moving Objects
          icon: Animation
          url: /moving_objects/obsplan

        - name: Earthquakes
          icon: Landslide
          url: /earthquakes

        - name: Galaxies
          icon: Cyclone
          url: /galaxies

        - name: Spatial Catalogs
          icon: Map
          url: /spatial_catalogs

        - name: Analysis Services
          icon: Science
          url: /services

        - name: Recurring API
          icon: EventRepeat
          url: /recurring_apis

        - name: Taxonomies
          icon: AccountTree
          url: /taxonomies

        - name: Tag Management
          icon: LocalOffer
          permissions: ["Manage sources", "System admin"]
          url: /tag_management

        - name: Scanning report
          icon: Summarize
          url: /candidates/scan_reports

        - name: Deployments
          icon: RocketLaunch
          url: /deployments

    - name: Admin
      icon: AdminPanelSettings
      permissions: ["Manage users", "System admin"]
      subitems:
        - name: DB Stats
          icon: Assessment
          permissions: ["System admin"]
          url: /db_stats
        - name: User Management
          icon: Group
          permissions: ["Manage users", "System admin"]
          url: /user_management

  homepage_widgets:
    # Hide unwanted skyportal defaults
    WeatherWidget:
      show: false
    SourceCounts:
      show: false
    TopSavers:
      show: false

    # xlg=16cols  lg=12cols  md=10cols  sm=6cols  xs=4cols
    # layout: [x, y, width, height]
    GroupList:
      props:
        title: My Groups
        linkToGroupSources: true
      resizeable: true
      minW: 2
      layouts:
        xlg: [0, 0, 2, 3]
        lg: [0, 0, 2, 3]
        md: [0, 0, 3, 2]
        sm: [0, 0, 3, 2]
        xs: [0, 0, 4, 2]

    RecentGcnEvents:
      resizeable: true
      minW: 2
      layouts:
        xlg: [2, 0, 4, 3]
        lg: [2, 0, 4, 3]
        md: [3, 0, 7, 2]
        sm: [3, 0, 3, 2]
        xs: [0, 2, 4, 3]

    RecentSources:
      resizeable: true
      minW: 2
      layouts:
        xlg: [6, 0, 5, 3]
        lg: [6, 0, 6, 3]
        md: [0, 2, 5, 3]
        sm: [0, 2, 3, 3]
        xs: [0, 5, 4, 3]

    NewsFeed:
      resizeable: true
      minW: 2
      layouts:
        xlg: [11, 0, 5, 4]
        lg: [0, 5, 6, 3]
        md: [5, 2, 5, 3]
        sm: [3, 2, 3, 3]
        xs: [0, 8, 4, 3]

    TelescopeMapWidget:
      show: true
      resizeable: true
      minW: 2
      layouts:
        xlg: [0, 2, 6, 3]
        lg: [0, 2, 6, 3]
        md: [0, 5, 5, 3]
        sm: [0, 5, 6, 3]
        xs: [0, 11, 4, 3]

    TopSources:
      resizeable: true
      minW: 2
      layouts:
        xlg: [6, 3, 5, 3]
        lg: [6, 3, 6, 3]
        md: [5, 5, 5, 3]
        sm: [0, 8, 6, 3]
        xs: [0, 14, 4, 2]

    GettingStarted:
      resizeable: true
      minW: 2
      layouts:
        xlg: [11, 4, 5, 2]
        lg: [6, 5, 6, 3]
        md: [0, 8, 10, 2]
        sm: [0, 11, 6, 2]
        xs: [0, 16, 4, 2]

  database:
    database: skyportal
    host: localhost
    port: 5432
    user: skyportal
    password:

server:
  protocol: http # UPDATE IN PROD
  host: localhost # UPDATE IN PROD
  port: 5000 # UPDATE IN PROD

  ssl: False # UPDATE IN PROD

  processes: 4 # UPDATE IN PROD
  dedicated_frontend_processes: 2 # UPDATE IN PROD

  auth:
    debug_login: True # UPDATE IN PROD
    backends:
      - name: iam-oauth2
        class: baselayer.app.auth.IAMOAuth2.IAMOAuth2
        key:
        secret:
        label: Sign in with IAM
    iam_oauth2_timeout: 15


notifications:
  enabled: True

additional_bandpasses:
  - name: 'swiftxrt'
    filterset: 'xrt'
    wavelength: [0.1, 1, 62, 100]
    transmission: [0, 1, 1, 0]
    description: "basic XRT filter - tophat transmission"
  - name: 'nicerxti'
    filterset: 'xti'
    wavelength: [0.1, 1.2, 41, 100]
    transmission: [0, 1, 1, 0]
    description: "basic XTI filter - tophat transmission"
  - name: 'epfxt'
    filterset: 'fxt'
    wavelength: [1.24, 24.82]
    transmission: [1, 1]
    description: "basic fxt filter - 0.5-10keV"
  - name: 'svommxt'
    filterset: 'mxt'
    wavelength: [0.1, 1.2, 25, 100]
    transmission: [0, 1, 1, 0]
    description: "basic MXT filter - tophat transmission"

user:
  default_role: 'Full user'

fink:
  fink_topics:
  - fink_kn_candidates_ztf
  - fink_early_kn_candidates_ztf
  - fink_rate_based_kn_candidates_ztf
  fink_username: null
  fink_password: null
  fink_group_id: null
  survey: lsst
  fink_servers: null
  skyportal_group: Fink
  skyportal_token: null
  skyportal_url: http://localhost:5000
  testing: false
  whitelisted: true

gcn:
  notice_types:
    voevent:
      - gcn.notices.svom.voevent.grm
      - gcn.notices.svom.voevent.eclairs
      - gcn.classic.voevent.SWIFT_BAT_GRB_LC
      - gcn.classic.voevent.SWIFT_BAT_GRB_POS_ACK
      - gcn.classic.voevent.SWIFT_XRT_POSITION
      - gcn.classic.voevent.ICECUBE_ASTROTRACK_GOLD
      - gcn.classic.voevent.ICECUBE_ASTROTRACK_BRONZE
      - gcn.classic.voevent.LVC_INITIAL
      - gcn.classic.voevent.LVC_UPDATE
      - gcn.classic.voevent.LVC_TEST
      - gcn.classic.voevent.LVC_RETRACTION
      - gcn.classic.voevent.LVC_PRELIMINARY
    json:
      - gcn.notices.einstein_probe.wxt.alert
      - gcn.notices.icecube.lvk_nu_track_search
  reject_tags:
    - MDC
    - Subthreshold
    - StarTrack_Lost_Lock
    - ECLAIRs-Catalog
  source_radius_threshold: 12.0 # max skymap cone radius to create a source, in arcmin

external_logging:
  sentry:
    endpoint:
    # Set traces_sample_rate to 1.0 to capture 100%
    # of transactions for performance monitoring.
    # Sentry recommends adjusting this value in production.
    traces_sample_rate: 0.25
    # Set profiles_sample_rate to 1.0 to profile 100%
    # of sampled transactions.
    # We recommend adjusting this value in production.
    profiles_sample_rate: 1.0
